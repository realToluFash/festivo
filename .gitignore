# dependencies
node_modules/
vendor/

# builds
dist/
build/
.expo/
ios/
android/
var/
public/bundles/

# local state
.data/
.env
.env.local
*.log

# editors / os
.DS_Store
.idea/
.vscode/

# Symfony Flex recipes install a compose file per service. The stack is defined
# once at the root; a second one here would quietly claim ports and define
# duplicate services.
services/api/compose.yaml
services/api/compose.override.yaml

# The OpenAPI document is fetched to generate types; the generated file is
# committed, the fetched document is not.
packages/api-client/.openapi.json
