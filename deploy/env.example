# deploy/.env on the server: copy this file, fill every line, chmod 600.
# Never commit the filled copy, and never take a value from this repository or its
# history: deploy/preflight.sh refuses one it finds there. Generate each secret
# fresh per environment, with the command beside it. deploy/README.md says who
# rotates each one and what rotating it ends.

# ── Where it runs ───────────────────────────────────────────────────────────
APP_HOST=
API_HOST=
RP_HOST=                       # the passkeys' relying party, when it is not APP_HOST; empty otherwise
ACME_EMAIL=

# ── Soirely's own keys (generated per environment) ──────────────────────────
APP_SECRET=                    # openssl rand -hex 32
MERCURE_PUBLISHER_KEY=         # openssl rand -hex 32
MERCURE_SUBSCRIBER_KEY=        # openssl rand -hex 32, a different value
JWT_PASSPHRASE=                # openssl rand -hex 32; the key pair goes in deploy/secrets/jwt
TWO_FACTOR_KEY=                # openssl rand -base64 32. Set once, never rotated
POSTGRES_USER=soirely
POSTGRES_DB=soirely
POSTGRES_PASSWORD=             # openssl rand -hex 32
DATABASE_URL=                  # postgresql://soirely:<POSTGRES_PASSWORD>@postgres:5432/soirely?serverVersion=17&charset=utf8
REDIS_PASSWORD=                # openssl rand -hex 32

# ── Addresses people see ────────────────────────────────────────────────────
SUPPORT_EMAIL=support@soirely.com
MAIL_FROM=Soirely <no-reply@soirely.com>

# ── Mail ────────────────────────────────────────────────────────────────────
MAILER_DSN=
MAIL_WEBHOOK_SECRET=           # user:password the provider's webhook sends
MAIL_WEBHOOK_ALLOWED_RANGES=   # the provider's published ranges, commas

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET_PRIVATE=
STORAGE_BUCKET_PUBLIC=
STORAGE_REGION=

# ── Phone ───────────────────────────────────────────────────────────────────
SMS_API_BASE=https://api.twilio.com
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
WHATSAPP_ENABLED=1
PHONE_CODES_SMS_ONLY_COUNTRIES=US
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CODE_TEMPLATE=soirely_code
WHATSAPP_WEBHOOK_VERIFY_TOKEN= # openssl rand -hex 32
WHATSAPP_APP_SECRET=

# ── Push ────────────────────────────────────────────────────────────────────
EXPO_PUSH_API_BASE=https://exp.host
EXPO_ACCESS_TOKEN=
VAPID_SUBJECT=mailto:support@soirely.com
VAPID_PUBLIC_KEY=              # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=

# ── Sign-in with Google and Apple (docs/architecture/sessions.md) ───────────
OAUTH_GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com
OAUTH_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
OAUTH_GOOGLE_CLIENT_IDS=
OAUTH_GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
OAUTH_GOOGLE_WEB_CLIENT_ID=
OAUTH_GOOGLE_WEB_CLIENT_SECRET=
OAUTH_APPLE_ISSUERS=https://appleid.apple.com
OAUTH_APPLE_JWKS_URIS=https://appleid.apple.com/auth/keys
OAUTH_APPLE_CLIENT_IDS=
OAUTH_APPLE_TOKEN_URI=https://appleid.apple.com/auth/token
OAUTH_APPLE_WEB_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_WEB_KEY_ID=
OAUTH_APPLE_WEB_PRIVATE_KEY=
OAUTH_APPLE_APP_LINK=
OAUTH_APPLE_RETURN_URI=

# ── Everything else ─────────────────────────────────────────────────────────
ADDRESS_ENDPOINT=https://nominatim.openstreetmap.org
ADDRESS_USER_AGENT=
DNS_TXT_ENDPOINT=https://cloudflare-dns.com/dns-query
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=anthropic
ASSISTANT_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_TOKENS=16000
CORS_EXPO_WEB_ORIGIN=
TEAM_SEAT_LIMIT=
MINIMUM_APP_VERSION_IOS=
MINIMUM_APP_VERSION_ANDROID=
SOIRELY_SCHEME=

# ── The app's claim on this host (App Links, passkeys) ──────────────────────
SOIRELY_ANDROID_CERT_SHA256=   # release fingerprint, then a QA build's, commas
SOIRELY_ANDROID_PACKAGE=com.soirely.app
SOIRELY_APPLE_APP_ID=          # <team id>.com.soirely.app
