{
	email {$ACME_EMAIL}
}

{$APP_HOST} {$RP_HOST} {
	encode zstd gzip

	# On RP_HOST, the passkeys' relying party, only the files that let the
	# app use its passkeys are served; everything else goes to APP_HOST.
	@elsewhere {
		not host {$APP_HOST}
		not path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	}
	redir @elsewhere https://{$APP_HOST}{uri} 308

	reverse_proxy web:80
}

{$API_HOST} {
	encode zstd gzip

	handle /.well-known/mercure* {
		reverse_proxy mercure:80 {
			flush_interval -1
		}
	}

	# Seating and floor plan take up to 180 s with the fallback (sc-3987).
	handle /api/assistant/* {
		reverse_proxy api:80 {
			transport http {
				response_header_timeout 200s
			}
		}
	}

	handle {
		reverse_proxy api:80 {
			transport http {
				response_header_timeout 60s
			}
		}
	}
}
