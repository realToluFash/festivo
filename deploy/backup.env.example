# deploy/backup.env on the server: read by the backup container alone. Copy this
# file, fill every line, chmod 600, never commit the filled copy.

BACKUP_BUCKET=                 # the backup bucket in sc-558's account, made by deploy/backup/bucket.sh
BACKUP_REGION=                 # sc-558's region
BACKUP_ENDPOINT=               # empty on AWS; the localstack address on the QA stack
AWS_ACCESS_KEY_ID=             # the backup job's credentials: list and write, never read, overwrite or delete
AWS_SECRET_ACCESS_KEY=
BACKUP_RECIPIENT=              # age public key (age1…); its identity is in the production secret store only
