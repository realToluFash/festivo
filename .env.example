# Copy to .env — `npm run setup` does it for you.
#
# Every value here is a safe local default. Anything marked CHANGE IN PRODUCTION
# is a credential that must not survive into a deployed environment.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=soirely
POSTGRES_PASSWORD=soirely          # CHANGE IN PRODUCTION
POSTGRES_DB=soirely
POSTGRES_PORT=5432
# Read by the API. The host is the compose service name, not localhost.
DATABASE_URL=postgresql://soirely:soirely@postgres:5432/soirely?serverVersion=17&charset=utf8

# ── API ─────────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=dev-secret-change-me        # CHANGE IN PRODUCTION
API_PORT=8080

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Mercure ──────────────────────────────────────────────────────────────────
# Two different keys on purpose: one shared key would let any subscriber publish.
MERCURE_PUBLISHER_KEY=dev-publisher-key-change-me      # CHANGE IN PRODUCTION
MERCURE_SUBSCRIBER_KEY=dev-subscriber-key-change-me    # CHANGE IN PRODUCTION
MERCURE_PORT=3000
# Space-separated. Add a LAN address here to test on a physical device.
MERCURE_CORS_ORIGINS=http://localhost:5173 http://localhost:8081 http://localhost:19006
# Where the API publishes to (inside the network) and where clients subscribe (from the host).
MERCURE_PUBLISH_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure

# ── Local provider sinks ─────────────────────────────────────────────────────
# Nothing below reaches a real provider. Switching to one is a change to these
# variables only — no code change.

# Mail. Set MAIL_DSN to a real provider to leave the sink behind.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAIL_DSN=smtp://mailpit:1025
MAIL_FROM="Soirely <no-reply@soirely.com>"

# SMS. Point SMS_API_BASE at the provider to leave the mock behind.
SMOCKER_MOCK_PORT=8086
SMOCKER_UI_PORT=8088
SMS_API_BASE=http://smocker:8080
SMS_ACCOUNT_SID=ACdevelopment00000000000000000000
SMS_AUTH_TOKEN=development-token          # CHANGE IN PRODUCTION
SMS_FROM=+447700900999

# OIDC. Swap the issuers for the real ones and nothing else changes.
OIDC_PORT=8089
OAUTH_GOOGLE_ISSUER=http://localhost:8089/google
OAUTH_GOOGLE_CLIENT_ID=soirely-dev
OAUTH_APPLE_ISSUER=http://localhost:8089/apple
OAUTH_APPLE_CLIENT_ID=soirely-dev
