# Copy to .env — `npm run setup` does it for you.
#
# Every value here is a safe local default. Anything marked CHANGE IN PRODUCTION
# is a credential that must not survive into a deployed environment.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=soirely
POSTGRES_PASSWORD=soirely          # CHANGE IN PRODUCTION
POSTGRES_DB=soirely
POSTGRES_PORT=5432
# Read by the API. The host is the compose service name, not localhost.
DATABASE_URL=postgresql://soirely:soirely@postgres:5432/soirely?serverVersion=17&charset=utf8

# ── API ─────────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=dev-secret-change-me        # CHANGE IN PRODUCTION
API_PORT=8080

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Mercure ──────────────────────────────────────────────────────────────────
# Two different keys on purpose: one shared key would let any subscriber publish.
MERCURE_PUBLISHER_KEY=dev-publisher-key-change-me      # CHANGE IN PRODUCTION
MERCURE_SUBSCRIBER_KEY=dev-subscriber-key-change-me    # CHANGE IN PRODUCTION
MERCURE_PORT=3000
# Space-separated. Add a LAN address here to test on a physical device.
MERCURE_CORS_ORIGINS=http://localhost:5173 http://localhost:8081 http://localhost:19006
# Where the API publishes to (inside the network) and where clients subscribe (from the host).
MERCURE_PUBLISH_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure

# ── Local provider sinks ─────────────────────────────────────────────────────
# Nothing below reaches a real provider. Switching to one is a change to these
# variables only — no code change.

# Mail. Set MAIL_DSN to a real provider to leave the sink behind.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAIL_DSN=smtp://mailpit:1025
MAIL_FROM="Soirely <no-reply@soirely.com>"
# Mailpit in development, which never delivers anywhere. A real transport here
# sends to real addresses from a developer's machine.
MAILER_DSN=smtp://mailpit:1025

# SMS. Point SMS_API_BASE at the provider to leave the mock behind.
SMOCKER_MOCK_PORT=8086
SMOCKER_UI_PORT=8088
SMS_API_BASE=http://smocker:8080
SMS_ACCOUNT_SID=ACdevelopment00000000000000000000
SMS_AUTH_TOKEN=development-token          # CHANGE IN PRODUCTION
SMS_FROM=+447700900999

# The Google and Apple sign-in sandbox. compose.yaml points the API and the web at it;
# production's values are in docs/architecture/sessions.md.
OIDC_PORT=8089

# The locale declaration, mounted into the API container. The web and mobile
# clients read the same file from the repository root.
LOCALES_FILE=/locales.json

# ── Object storage ───────────────────────────────────────────────────────────
STORAGE_KEY=soirely
STORAGE_SECRET=soirely-dev-secret     # CHANGE IN PRODUCTION
STORAGE_PORT=4566
# The endpoint the API signs against (inside the network) and the one a browser
# uploads to (from the host). They differ locally and are usually the same in
# production — a signature made for one host is not valid for the other.
STORAGE_ENDPOINT=http://storage:4566
STORAGE_PUBLIC_ENDPOINT=http://localhost:4566
STORAGE_BUCKET_PRIVATE=soirely-private
STORAGE_BUCKET_PUBLIC=soirely-public
STORAGE_REGION=us-east-1

# ── Address lookup ───────────────────────────────────────────────────────────
# OpenStreetMap's geocoder — no key needed, which is why it is the first
# adapter: the whole path develops and tests without an account. A commercial
# provider is another class behind the same interface.
ADDRESS_ENDPOINT=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires identifying yourself. Not decoration.
ADDRESS_USER_AGENT=Soirely/1.0 (+https://soirely.com)

# ── Assistant ────────────────────────────────────────────────────────────────
# The one provider sink that is not a container. `scripted` is a class in the
# API answering canned replies with no key and no network — the default, and
# what the test suite is pinned to, so no assisted path is ever billable here.
# Switch to `anthropic` and add a key to use the real thing.
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=scripted
ASSISTANT_API_KEY=                        # required only for ASSISTANT_PROVIDER=anthropic
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=medium                   # low | medium | high | xhigh | max
ASSISTANT_MAX_TOKENS=16000                # thinking and reply share this budget

# ── Web client ───────────────────────────────────────────────────────────────
# Read by the container at START-UP and written into /config.json, never baked
# into the bundle. These are the URLs as the BROWSER sees them — `api` and
# `mercure` resolve inside the compose network and nowhere in a browser.
WEB_PORT=5173
SOIRELY_API_URL=http://localhost:8080
SOIRELY_MERCURE_URL=http://localhost:3000/.well-known/mercure
SOIRELY_ENVIRONMENT=dev

# ── Who may call the API from a browser ──────────────────────────────────────
# Exact origins, not patterns: the API allows credentials, so these are the
# pages permitted to make signed-in calls with the refresh cookie attached.
# A native client sends no Origin header and none of this applies to it.
# Leave the Expo slot empty outside development.
#
# CORS_WEB_ORIGIN and SOIRELY_API_URL above have to be the same site: the
# refresh cookie is SameSite=Strict, so a browser never sends it to another
# registrable domain, and apps/web refuses to start when they differ. See
# docs/architecture/sessions.md.
CORS_WEB_ORIGIN=http://localhost:5173
CORS_EXPO_WEB_ORIGIN=http://localhost:8081
