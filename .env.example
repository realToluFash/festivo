# Copy to .env — `npm run setup` does it for you.
#
# Every value here is a safe local default. Anything marked CHANGE IN PRODUCTION
# is a credential that must not survive into a deployed environment.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=soirely
POSTGRES_PASSWORD=soirely          # CHANGE IN PRODUCTION
POSTGRES_DB=soirely
POSTGRES_PORT=5432
# Read by the API. The host is the compose service name, not localhost.
DATABASE_URL=postgresql://soirely:soirely@postgres:5432/soirely?serverVersion=17&charset=utf8

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Mercure ──────────────────────────────────────────────────────────────────
# Two different keys on purpose: one shared key would let any subscriber publish.
MERCURE_PUBLISHER_KEY=dev-publisher-key-change-me      # CHANGE IN PRODUCTION
MERCURE_SUBSCRIBER_KEY=dev-subscriber-key-change-me    # CHANGE IN PRODUCTION
MERCURE_PORT=3000
# Space-separated. Add a LAN address here to test on a physical device.
MERCURE_CORS_ORIGINS=http://localhost:5173 http://localhost:8081 http://localhost:19006
# Where the API publishes to (inside the network) and where clients subscribe (from the host).
MERCURE_PUBLISH_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
