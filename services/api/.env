# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> assistant ###
# Whether this installation offers the assistant at all. Off is a legitimate
# configuration, answered with its own code so a client can tell it apart from
# an outage.
ASSISTANT_ENABLED=true
# `scripted` answers locally with no key and no network — the default, so the
# stack comes up assisted on a machine with no account. `anthropic` is the real
# one and needs a key.
ASSISTANT_PROVIDER=scripted
ASSISTANT_API_KEY=
ASSISTANT_MODEL=claude-opus-5
# Depth against latency. Somebody is waiting, and on this model the lower levels
# are strong; raise it per flow when there is evidence the flow needs it.
ASSISTANT_EFFORT=medium
# Covers thinking AND the reply together. A budget sized for the answer alone
# truncates mid-sentence once the model starts thinking.
ASSISTANT_MAX_TOKENS=16000
###< assistant ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
JWT_PASSPHRASE=5b08d4c1a4a31085e24693f4c4467346ee6e90387ad25f282761f47e3fae582c
###< lexik/jwt-authentication-bundle ###

###> password breach check ###
# Have I Been Pwned's range API, queried with a five-character hash prefix so
# the password never leaves this process. Off for a developer with no network:
# the adapter already fails open, so this only saves the three-second timeout
# on every registration.
PASSWORD_BREACH_CHECK_ENABLED=1
###< password breach check ###

###> symfony/mailer ###
# Mailpit in development: everything the product sends lands in a web inbox at
# :8025 and nothing reaches a real address.
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM="Soirely <no-reply@soirely.com>"
###< symfony/mailer ###

###> sms ###
# The SMS mock in development, which answers as Twilio does and delivers
# nowhere. Point SMS_API_BASE at the provider to leave it behind.
SMS_API_BASE=http://smocker:8080
SMS_ACCOUNT_SID=ACdevelopment00000000000000000000
SMS_AUTH_TOKEN=development-token
SMS_FROM=+447700900999
###< sms ###

###> nelmio/cors-bundle ###
# The origins our own browser clients are served from, exactly. A native
# client sends no Origin at all and none of this applies to it.
CORS_WEB_ORIGIN=http://localhost:5173
CORS_EXPO_WEB_ORIGIN=http://localhost:8081
###< nelmio/cors-bundle ###

###> Google sign-in (sc-58) ###
# The local sandbox (compose service `oidc`) stands in for Google. A browser reaches it at
# localhost:8089, which is the issuer its tokens name; the API fetches its keys inside the
# network. In production: https://accounts.google.com,accounts.google.com and Google's
# https://www.googleapis.com/oauth2/v3/certs, with each client's own id as an audience.
# The sandbox names its issuer after the host it was asked on, so a code the API redeems inside the
# network comes back as oidc:8080. Google's real issuers are in sessions.md.
OAUTH_GOOGLE_ISSUERS=http://localhost:8089/google,http://oidc:8080/google
OAUTH_GOOGLE_JWKS_URI=http://oidc:8080/google/jwks
OAUTH_GOOGLE_CLIENT_IDS=soirely-web,soirely-app
# The web client's code is redeemed here, with the secret only the API holds (sc-58, Decided 17 Oct).
OAUTH_GOOGLE_TOKEN_URI=http://oidc:8080/google/token
OAUTH_GOOGLE_WEB_CLIENT_ID=soirely-web
OAUTH_GOOGLE_WEB_CLIENT_SECRET=development-secret
###< Google sign-in (sc-58) ###

###> Apple sign-in (sc-59) ###
# The sandbox stands in for Apple on web and Android. The iPhone's native sheet talks to the
# real Apple, so its issuer, its keys and Expo Go's bundle id are trusted too. In production
# the web client's secret is a JWT signed with the Apple key (see sessions.md).
OAUTH_APPLE_ISSUERS=http://localhost:8089/apple,http://oidc:8080/apple,https://appleid.apple.com
OAUTH_APPLE_JWKS_URIS=http://oidc:8080/apple/jwks,https://appleid.apple.com/auth/keys
OAUTH_APPLE_CLIENT_IDS=soirely-web,soirely-app,com.soirely.app,host.exp.Exponent
OAUTH_APPLE_TOKEN_URI=http://oidc:8080/apple/token
OAUTH_APPLE_WEB_CLIENT_ID=soirely-web
OAUTH_APPLE_WEB_CLIENT_SECRET=development-secret
# Where Apple's form_post sends an Android attempt back: an https App Link on Soirely's
# domain that the app has verified (assetlinks.json), never a custom scheme.
OAUTH_APPLE_APP_LINK=http://localhost:5173/oauth/apple/app
###< Apple sign-in (sc-59) ###

###> two-factor ###
# Encrypts each authenticator secret at rest: 32 random bytes, base64. Empty here, so an
# environment that sets none refuses any two-factor work; development's is in .env.dev. A changed
# key strands every enrolled factor, so it is rotated deliberately or not at all.
TWO_FACTOR_KEY=
###< two-factor ###
